# ==================================================
# ERCA&RIS environment configuration
# Copy to .env and fill in what you have. Every value
# is optional -- anything left blank falls back to a
# safe local/mock implementation so the platform still
# runs end-to-end with zero external accounts.
# ==================================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Defaults to a local SQLite file if left blank:
#   sqlite:///./runtime/erca_ris.db
# Point this at Postgres+pgvector to use that instead, e.g.:
#   postgresql+psycopg2://erca:erca@localhost:5432/erca_ris
DATABASE_URL=

# --- GitHub integration ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main

# --- LLM provider ---
# auto | openai | huggingface | offline
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
HF_TOKEN=
HF_MODEL=

# --- Embeddings ---
# auto | openai | offline
EMBEDDING_PROVIDER=auto
EMBEDDING_DIM=256

# --- Notifications ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=erca-ris@example.com

# --- CORS ---
# Comma-separated list of allowed origins for the ERCA&RIS backend.
# Never use "*" in production.
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# --- RAG ---
RAG_TOP_K=5
RAG_KNOWN_INCIDENT_THRESHOLD=0.92

# --- Developer identity resolution ---
# Optional JSON override. If empty, repositories/repo/developer_roster.json is used for local/demo mode.
# Example (multiple developers per team): {"@payment-team":{"team":"Payment Engineering","developers":[{"display_name":"Payment Developer","username":"payment-dev","email":"payment-dev@company.com","active":true,"priority":10},{"display_name":"Payment Backup","username":"payment-backup","email":"payment-backup@company.com","active":true,"priority":20}]}}
SCM_PROVIDER=github
TEAM_DEVELOPERS_JSON={}
DEVELOPER_EMAILS_JSON={}
